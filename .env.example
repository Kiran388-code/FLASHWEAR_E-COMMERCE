# Application Settings
APP_NAME=FLASHWEAR-BACKEND
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Settings (PostgreSQL Async)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flashwear_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flashwear_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Celery Settings
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Elasticsearch Settings
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Firebase Settings
FIREBASE_PROJECT_ID=flashwear-firebase-dev
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# Security Settings
JWT_SECRET_KEY=supersecretkeythatisatleast32characterslongforjwtsecurity
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
